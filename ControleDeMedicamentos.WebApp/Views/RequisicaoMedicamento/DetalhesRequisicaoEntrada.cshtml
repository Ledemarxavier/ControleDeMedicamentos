@model ControleDeMedicamentos.WebApp.Models.DetalhesRequisicaoEntradaViewModel

@{
    ViewBag.Titulo = "Detalhes da Requisição de Entrada";
}

<div class="container mt-4">
    <div class="card shadow-lg rounded-3">
        <div class="card-body">
            <h3 class="card-title text-primary mb-4">
                <i class="bi bi-box-arrow-in-down"></i> Requisição de Entrada
            </h3>

            <p class="card-text"><strong>ID:</strong> @Model.Id</p>
            <p class="card-text"><strong>Data de Ocorrência:</strong> @Model.DataOcorrencia.ToString("dd/MM/yyyy HH:mm")</p>
            <p class="card-text"><strong>Funcionário:</strong> @Model.Funcionario</p>
            <p class="card-text"><strong>Medicamento:</strong> @Model.Medicamento</p>
            <p class="card-text"><strong>Quantidade Requisitada:</strong> @Model.QuantidadeRequisitada</p>
        </div>

        <div class="card-footer d-flex justify-content-end gap-2">
            <a class="btn btn-secondary" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>
</div>
